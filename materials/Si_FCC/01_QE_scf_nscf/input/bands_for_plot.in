&control
    calculation = 'bands'
    prefix = 'Si'
    pseudo_dir = './pseudo'
    outdir = './output'
/
&system
    ibrav = 2
    celldm(1) = 10.263
    nat = 2
    ntyp = 1
    ecutwfc = 18.0
    nbnd = 20
/
&electrons
    diagonalization = 'cg'
/
ATOMIC_SPECIES
    Si 28.086 Si.upf
ATOMIC_POSITIONS alat
    Si 0.00 0.00 0.00
    Si 0.25 0.25 0.25
K_POINTS crystal_b
    5
    0.500 0.500 0.500 20 ! L
    0.000 0.000 0.000 20 ! Gamma
    0.500 0.000 0.500 20 ! X
    0.375 0.375 0.750 20 ! K
    0.000 0.000 0.000 1  ! Gamma
    