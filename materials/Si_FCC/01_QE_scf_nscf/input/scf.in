&control
    calculation = 'scf'
    prefix = 'Si'
    pseudo_dir = './pseudo'
    outdir = './output'
/
&system
    ibrav = 2
    celldm(1) = 10.263
    nat = 2
    ntyp = 1
    ecutwfc = 18.0
/
&electrons
    diagonalization = 'cg'
    ! mixing_beta = 0.7
    conv_thr = 1.0d-8
/
ATOMIC_SPECIES
    Si 28.086 Si.upf
ATOMIC_POSITIONS alat
    Si 0.00 0.00 0.00
    Si 0.25 0.25 0.25
K_POINTS automatic
    4 4 4 1 1 1